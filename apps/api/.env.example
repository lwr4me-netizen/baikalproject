# Скопируйте в .env и заполните. Ничего из реальных секретов не должно попадать в git.

ARBITRPACK_ENVIRONMENT=development
ARBITRPACK_SECRET_KEY=change-me-to-a-random-64-char-string

ARBITRPACK_DATABASE_URL=postgresql+psycopg://arbitrpack:arbitrpack@localhost:5432/arbitrpack

ARBITRPACK_S3_ENDPOINT_URL=http://localhost:9000
ARBITRPACK_S3_ACCESS_KEY=minioadmin
ARBITRPACK_S3_SECRET_KEY=minioadmin
ARBITRPACK_S3_BUCKET=arbitrpack-files
ARBITRPACK_S3_REGION=us-east-1
ARBITRPACK_S3_USE_LOCAL_FALLBACK=false

# mock | yookassa. Начинайте с mock — не требует ключей.
ARBITRPACK_PAYMENT_PROVIDER=mock
# Получить в личном кабинете тестового магазина: https://yookassa.ru/my/onboarding/testing
ARBITRPACK_YOOKASSA_SHOP_ID=
ARBITRPACK_YOOKASSA_SECRET_KEY=
ARBITRPACK_YOOKASSA_API_BASE=https://api.yookassa.ru/v3

ARBITRPACK_FRONTEND_BASE_URL=http://localhost:3000
ARBITRPACK_API_BASE_URL=http://localhost:8000
# На проде (домен baikalproject.pro):
# ARBITRPACK_FRONTEND_BASE_URL=https://baikalproject.pro
# ARBITRPACK_API_BASE_URL=https://baikalproject.pro

ARBITRPACK_DOWNLOAD_TOKEN_TTL_SECONDS=900

# Токен для GET /api/admin/metrics. Сгенерируйте случайную строку.
ARBITRPACK_ADMIN_TOKEN=
