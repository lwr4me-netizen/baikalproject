# Корневой .env для docker-compose. Скопируйте в .env и заполните.
# Ничего из реальных секретов не должно попадать в git (см. .gitignore).

POSTGRES_USER=arbitrpack
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=arbitrpack

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password

ARBITRPACK_ENVIRONMENT=development
ARBITRPACK_SECRET_KEY=change-me-to-a-random-64-char-string
ARBITRPACK_ADMIN_TOKEN=change-me-admin-token

# mock | yookassa
ARBITRPACK_PAYMENT_PROVIDER=mock
ARBITRPACK_YOOKASSA_SHOP_ID=
ARBITRPACK_YOOKASSA_SECRET_KEY=

ARBITRPACK_FRONTEND_BASE_URL=http://localhost:3000
ARBITRPACK_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# На проде (домен baikalproject.pro, см. docs/deployment.md) замените три строки выше на:
# ARBITRPACK_FRONTEND_BASE_URL=https://baikalproject.pro
# ARBITRPACK_API_BASE_URL=https://baikalproject.pro
# NEXT_PUBLIC_API_BASE_URL=https://baikalproject.pro
